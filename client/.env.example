# Donna client configuration
# Copy this file to `.env` and fill in your values.

# OpenAI-compatible API key (required).
# Works with any OpenAI-compatible backend: OpenAI, Together, Anthropic via gateway,
# Ollama (no key needed but the var must be set to anything non-empty), etc.
LLM_API_KEY=sk-replace-me

# Override to point at a self-hosted or alternative provider.
# Default: https://api.openai.com/v1
#
# DeepSeek V4 (100x cheaper, strong JSON extraction — ideal for high-volume firms):
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-v4-flash    # fast + cheap; use deepseek-v4-pro for highest accuracy
#
# Ollama (fully offline, no API key):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
LLM_BASE_URL=

# Model name. Must be available on whichever provider LLM_BASE_URL points at.
# Default: gpt-4o-mini
LLM_MODEL=

# Optional: route extracted intents to your own backend after extraction.
# Leave blank to use the hosted runtime at https://donnaoss.com (free during pre-alpha).
DONNA_RUNTIME_URL=

# Where Donna reads system prompts from. Defaults to the sibling voice-prompts/ folder.
PROMPT_DIR=

# Below this score, Donna asks a clarifying question instead of locking the entry.
CONFIDENCE_THRESHOLD=0.7

# SQLite path for the offline-first local cache.
CACHE_DB=

# --- PII Shield (wired default-on; redacts client data before the cloud LLM) ---
# Set to 0/false/off to disable the shield entirely (NOT recommended).
DONNA_PII_SHIELD=

# Layer-2 redaction model endpoint. MUST be a local host — a cloud URL is
# refused at startup (sending raw transcript off-machine would defeat the
# shield). Default: http://localhost:11434/v1 (Ollama). If this endpoint is
# unreachable the shield fails closed: the cloud LLM call is blocked, not
# allowed through un-redacted.
PII_LOCAL_LLM_BASE_URL=

# Local model name for the layer-2 PII pass. Default: llama3.2
PII_LOCAL_LLM_MODEL=
