{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(self), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://hal.grip-web.com; frame-ancestors 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/(.*\\.(?:html|css|js|svg|png|jpg|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/signup", "destination": "/api/signup" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/widget-notarise", "destination": "/api/widget-notarise" },
    { "source": "/api/widget-chain", "destination": "/api/widget-chain" },
    { "source": "/api/widget-verify", "destination": "/api/widget-verify" }
  ]
}
